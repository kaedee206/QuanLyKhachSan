@model List<Room>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dọn phòng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0" style="color: #1A3C5E; font-weight: 700;">
            <i class="bi bi-droplet me-2" style="color: #2E8B8B;"></i>
            Dọn phòng
        </h4>
        <small class="text-muted">Các phòng cần dọn dẹp (@Model.Count phòng)</small>
    </div>
    <a asp-controller="Room" asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;">
        <i class="bi bi-building"></i> Sơ đồ phòng
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var room in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-top: 4px solid #ffc107;">
                    <div class="card-body text-center">
                        <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(255,193,7,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
                            <i class="bi bi-droplet-half" style="font-size: 1.5rem; color: #ffc107;"></i>
                        </div>
                        <h5 class="mb-1" style="color: #1A3C5E; font-weight: 700;">@room.RoomNumber</h5>
                        <div class="text-muted mb-1" style="font-size: 0.82rem;">@room.RoomType?.Name</div>
                        <div class="mb-3" style="font-size: 0.78rem;">
                            <span class="badge bg-warning text-dark">Tầng @room.Floor</span>
                        </div>
                        <form asp-controller="Room" asp-action="MarkCleaned" asp-route-id="@room.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm w-100" style="background: #2E8B8B; color: white; border-radius: 8px;" onclick="return confirm('Xác nhận đã dọn xong phòng @room.RoomNumber?');">
                                <i class="bi bi-check-circle"></i> Đã dọn xong
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body text-center py-5">
            <i class="bi bi-emoji-smile" style="font-size: 3rem; color: #28a745;"></i>
            <h5 class="mt-3" style="color: #1A3C5E;">Tất cả phòng đã sạch!</h5>
            <p class="text-muted">Không có phòng nào cần dọn dẹp.</p>
        </div>
    </div>
}
