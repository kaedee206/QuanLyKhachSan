@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <h4 style="font-family: 'Playfair Display', serif; font-weight: 700; color: #0F2540;">
        <i class="bi bi-key me-2" style="color: #D4AF37;"></i>Đổi mật khẩu
    </h4>
    <p style="color: #6b7280; font-size: 0.9rem;">Cập nhật mật khẩu tài khoản của bạn</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div style="background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.05);">
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 px-3 mb-3" style="font-size: 0.85rem; border-radius: 10px;">
                    <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.85rem; border-radius: 10px;">
                    <i class="bi bi-exclamation-circle me-1"></i> @TempData["Error"]
                </div>
            }

            <form asp-controller="Auth" asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.85rem;"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label" style="font-size: 0.82rem; font-weight: 600; color: #1A3C5E;"></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: #F5F0E8; border-color: #e0d8cc; color: #D4AF37;">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại"
                               style="border-color: #e0d8cc; border-radius: 0 10px 10px 0;" />
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label" style="font-size: 0.82rem; font-weight: 600; color: #1A3C5E;"></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: #F5F0E8; border-color: #e0d8cc; color: #D4AF37;">
                            <i class="bi bi-key"></i>
                        </span>
                        <input asp-for="NewPassword" class="form-control" placeholder="Nhập mật khẩu mới (tối thiểu 8 ký tự)"
                               style="border-color: #e0d8cc; border-radius: 0 10px 10px 0;" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label" style="font-size: 0.82rem; font-weight: 600; color: #1A3C5E;"></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: #F5F0E8; border-color: #e0d8cc; color: #D4AF37;">
                            <i class="bi bi-key-fill"></i>
                        </span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới"
                               style="border-color: #e0d8cc; border-radius: 0 10px 10px 0;" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <button type="submit" class="btn w-100" style="background: linear-gradient(135deg, #D4AF37, #F0D060); color: #1A3C5E; font-weight: 600; border-radius: 12px; padding: 12px;">
                    <i class="bi bi-check-circle me-1"></i> Đổi mật khẩu
                </button>
            </form>
        </div>

        <!-- Password hints -->
        <div style="background: white; border-radius: 16px; padding: 1.25rem; margin-top: 1rem; box-shadow: 0 4px 15px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.05);">
            <h6 style="font-weight: 600; color: #1A3C5E; font-size: 0.85rem; margin-bottom: 0.75rem;">
                <i class="bi bi-info-circle me-1" style="color: #D4AF37;"></i> Yêu cầu mật khẩu
            </h6>
            <ul style="font-size: 0.82rem; color: #6b7280; margin: 0; padding-left: 1.2rem;">
                <li>Tối thiểu 8 ký tự</li>
                <li>Nên bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt</li>
                <li>Không sử dụng lại mật khẩu cũ</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
