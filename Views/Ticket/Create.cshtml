@model CreateTicketViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tạo Ticket";
    var rooms = ViewBag.Rooms as List<Room> ?? new List<Room>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0" style="color: #1A3C5E; font-weight: 700;">
            <i class="bi bi-plus-circle me-2" style="color: #D4AF37;"></i>
            Tạo Ticket Mới
        </h4>
        <small class="text-muted">Báo cáo sự cố hoặc yêu cầu bảo trì</small>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RoomId" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <select asp-for="RoomId" class="form-select" style="border-radius: 8px;">
                                <option value="">-- Chọn phòng --</option>
                                @foreach (var room in rooms)
                                {
                                    <option value="@room.Id">@room.RoomNumber — Tầng @room.Floor (@room.RoomType?.Name)</option>
                                }
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <select asp-for="Type" class="form-select" style="border-radius: 8px;">
                                <option value="@TicketType.Maintenance">Bảo trì</option>
                                <option value="@TicketType.Housekeeping">Dọn phòng</option>
                                <option value="@TicketType.Service">Dịch vụ</option>
                                <option value="@TicketType.Other">Khác</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <select asp-for="Priority" class="form-select" style="border-radius: 8px;">
                                <option value="@TicketPriority.Low">Thấp</option>
                                <option value="@TicketPriority.Medium" selected>Trung bình</option>
                                <option value="@TicketPriority.High">Cao</option>
                                <option value="@TicketPriority.Urgent">Khẩn cấp</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" style="border-radius: 8px;" placeholder="Mô tả chi tiết sự cố hoặc yêu cầu..."></textarea>
                            <span asp-validation-for="Description" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn" style="background: linear-gradient(135deg, #D4AF37, #F0D060); color: #1A3C5E; font-weight: 600; border-radius: 8px; padding: 10px 30px;">
                            <i class="bi bi-check-lg"></i> Tạo ticket
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px; padding: 10px 30px;">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
