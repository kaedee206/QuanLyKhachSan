@model PaginatedList<Service>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0" style="color: #1A3C5E; font-weight: 700;">
            <i class="bi bi-concierge-bell me-2" style="color: #D4AF37;"></i>
            Quản lý Dịch vụ
        </h4>
        <small class="text-muted">Tổng cộng @Model.TotalCount dịch vụ</small>
    </div>
    <a asp-action="Create" class="btn btn-sm" style="background: linear-gradient(135deg, #D4AF37, #F0D060); color: #1A3C5E; font-weight: 600; border-radius: 8px;">
        <i class="bi bi-plus-lg"></i> Thêm dịch vụ
    </a>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size: 0.85rem;">
                <thead style="background: #f8f6f0;">
                    <tr>
                        <th class="border-0 px-4 py-2">Mã booking</th>
                        <th class="border-0 py-2">Tên dịch vụ</th>
                        <th class="border-0 py-2">Loại</th>
                        <th class="border-0 py-2 text-center">Số lượng</th>
                        <th class="border-0 py-2 text-end">Đơn giá</th>
                        <th class="border-0 py-2 text-end">Thành tiền</th>
                        <th class="border-0 py-2">Ngày tạo</th>
                        <th class="border-0 py-2 text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Items)
                    {
                        var typeLabel = s.ServiceType switch
                        {
                            ServiceType.Laundry => "Giặt ủi",
                            ServiceType.Minibar => "Minibar",
                            ServiceType.Breakfast => "Ăn sáng",
                            ServiceType.Transport => "Vận chuyển",
                            ServiceType.Extra => "Phụ thu",
                            ServiceType.VietQR => "VietQR",
                            _ => s.ServiceType.ToString()
                        };
                        var typeBadge = s.ServiceType switch
                        {
                            ServiceType.Laundry => "bg-info text-dark",
                            ServiceType.Minibar => "bg-primary",
                            ServiceType.Breakfast => "bg-warning text-dark",
                            ServiceType.Transport => "bg-secondary",
                            ServiceType.Extra => "bg-dark",
                            ServiceType.VietQR => "bg-success",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td class="px-4">
                                <a asp-controller="Booking" asp-action="Detail" asp-route-id="@s.BookingId" style="color: #1A3C5E; font-weight: 600; text-decoration: none;">
                                    @s.Booking?.BookingCode
                                </a>
                            </td>
                            <td>@s.ServiceName</td>
                            <td><span class="badge @typeBadge" style="font-size: 0.72rem;">@typeLabel</span></td>
                            <td class="text-center">@s.Quantity</td>
                            <td class="text-end">@s.UnitPrice.ToString("N0") VNĐ</td>
                            <td class="text-end fw-bold">@s.TotalAmount.ToString("N0") VNĐ</td>
                            <td>@s.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Xác nhận xóa dịch vụ này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.75rem; border-radius: 6px;" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                <div class="mt-2">Chưa có dịch vụ nào</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ═══ PAGINATION ═══ -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-center">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Page - 1)" style="border-radius: 6px; margin: 0 2px;">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-Page="@i" style="border-radius: 6px; margin: 0 2px; @(i == Model.Page ? "background: #1A3C5E; border-color: #1A3C5E;" : "")">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Page + 1)" style="border-radius: 6px; margin: 0 2px;">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
