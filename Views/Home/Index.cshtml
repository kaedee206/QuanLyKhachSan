@{
    ViewData["Title"] = "Sun Hotel & Resort - Khách sạn 4 sao đẳng cấp";
    var roomTypes = ViewBag.RoomTypes as List<RoomType> ?? new List<RoomType>();
    var availableByType = ViewBag.AvailableByType as Dictionary<int, int> ?? new Dictionary<int, int>();
    var totalByType = ViewBag.TotalByType as Dictionary<int, int> ?? new Dictionary<int, int>();
    var totalAvailable = ViewBag.TotalAvailable as int? ?? 0;
    var totalRooms = ViewBag.TotalRooms as int? ?? 0;
}

@section Styles {
<style>
    /* ═══ DESIGN TOKENS & VARIABLES ═══ */
    :root {
        --sun-gold: #D4AF37;
        --sun-gold-light: #F7E7B4;
        --sun-gold-dark: #A38020;
        --sun-navy: #0F2540;
        --sun-navy-deep: #091524;
        --sun-navy-mid: #1A3C5E;
        --sun-teal: #2E8B8B;
        --sun-ivory: #F8FAFC;
        --sun-sand: #F5F0E8;
    }

    /* ═══ HERO SECTION ═══ */
    .hero-section {
        position: relative;
        min-height: 85vh;
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, rgba(9, 21, 36, 0.92) 0%, rgba(15, 37, 64, 0.85) 45%, rgba(15, 37, 64, 0.70) 100%),
                    url('/images/hotel-assets/hero/luxury-resort-hero.jpg') center center / cover no-repeat;
        padding: 6.5rem 0 5.5rem;
        color: white;
        overflow: hidden;
    }

    .hero-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(212, 175, 55, 0.15);
        border: 1px solid rgba(212, 175, 55, 0.35);
        color: var(--sun-gold-light);
        padding: 7px 18px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 1.5rem;
        backdrop-filter: blur(8px);
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 3.5rem;
        font-weight: 700;
        color: #FFFFFF;
        line-height: 1.18;
        margin-bottom: 1.25rem;
        letter-spacing: -0.5px;
    }

    .hero-title span {
        background: linear-gradient(135deg, #FFFFFF 20%, var(--sun-gold-light) 60%, var(--sun-gold) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-subtitle {
        color: rgba(255, 255, 255, 0.82);
        font-size: 1.12rem;
        line-height: 1.75;
        max-width: 560px;
        font-weight: 300;
        margin-bottom: 2rem;
    }

    .btn-gold {
        background: linear-gradient(135deg, var(--sun-gold) 0%, #F5D77F 100%);
        color: var(--sun-navy);
        font-weight: 700;
        border: none;
        border-radius: 12px;
        padding: 13px 30px;
        font-size: 0.95rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(212, 175, 55, 0.25);
        display: inline-flex;
        align-items: center;
    }

    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
        color: var(--sun-navy);
    }

    .btn-outline-gold {
        border: 1.5px solid rgba(212, 175, 55, 0.6);
        color: var(--sun-gold-light);
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(6px);
        font-weight: 600;
        border-radius: 12px;
        padding: 12px 28px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-outline-gold:hover {
        background: rgba(212, 175, 55, 0.15);
        border-color: var(--sun-gold);
        color: #FFFFFF;
        transform: translateY(-2px);
    }

    /* Glassmorphism Feature Card on Hero Right */
    .hero-glass-card {
        background: rgba(15, 37, 64, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 20px;
        padding: 2.25rem 2rem;
        backdrop-filter: blur(16px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    .hero-feature-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding-bottom: 1.25rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-feature-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0;
    }

    .hero-feature-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(212, 175, 55, 0.15);
        border: 1px solid rgba(212, 175, 55, 0.25);
        color: var(--sun-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    /* ═══ SEARCH BAR ═══ */
    .search-section {
        margin-top: -3rem;
        position: relative;
        z-index: 20;
    }

    .search-card {
        background: #FFFFFF;
        border-radius: 18px;
        padding: 1.75rem 2.25rem;
        box-shadow: 0 16px 45px rgba(15, 37, 64, 0.12);
        border: 1px solid #E2E8F0;
    }

    .search-card .form-label {
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--sun-navy);
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 6px;
    }

    .search-card .form-control,
    .search-card .form-select {
        border: 1px solid #CBD5E1;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 0.92rem;
        color: #1E293B;
        transition: all 0.2s ease;
    }

    .search-card .form-control:focus,
    .search-card .form-select:focus {
        border-color: var(--sun-gold);
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
    }

    /* ═══ SECTION TITLES ═══ */
    .section-eyebrow {
        color: var(--sun-gold);
        font-weight: 700;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 2.25rem;
        color: var(--sun-navy);
        letter-spacing: -0.3px;
    }

    .section-subtitle {
        color: #64748B;
        font-size: 1.02rem;
        max-width: 600px;
        margin: 0.5rem auto 0;
        line-height: 1.6;
    }

    /* ═══ ROOM CARDS ═══ */
    .hotel-room-card {
        background: #FFFFFF;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(15, 37, 64, 0.05);
        border: 1px solid #E2E8F0;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .hotel-room-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 40px rgba(15, 37, 64, 0.12);
        border-color: rgba(212, 175, 55, 0.4);
    }

    .hotel-room-card-img-wrap {
        position: relative;
        overflow: hidden;
        height: 230px;
        background: #0F2540;
    }

    .hotel-room-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hotel-room-card:hover .hotel-room-card-img {
        transform: scale(1.06);
    }

    .hotel-room-card-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        background: rgba(15, 37, 64, 0.85);
        backdrop-filter: blur(6px);
        color: #FFFFFF;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .hotel-room-card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }

    .hotel-room-card-name {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1.25rem;
        color: var(--sun-navy);
        margin-bottom: 0.45rem;
    }

    .hotel-room-card-desc {
        color: #64748B;
        font-size: 0.88rem;
        margin-bottom: 1rem;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hotel-room-card-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 0.82rem;
        color: #64748B;
        margin-bottom: 1.25rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #F1F5F9;
    }

    .hotel-room-card-price {
        font-family: 'Playfair Display', serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--sun-gold-dark);
    }

    .hotel-room-card-price small {
        font-size: 0.78rem;
        font-weight: 500;
        color: #94A3B8;
        font-family: 'Inter', sans-serif;
    }

    /* ═══ AMENITIES CARDS ═══ */
    .amenities-section {
        background: #F8FAFC;
    }

    .amenity-card {
        background: #FFFFFF;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .amenity-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 14px 30px rgba(15, 37, 64, 0.08);
        border-color: rgba(212, 175, 55, 0.4);
    }

    .amenity-card-img {
        width: 100%;
        height: 140px;
        object-fit: cover;
        background: #1A3C5E;
    }

    .amenity-card-content {
        padding: 1.25rem;
        text-align: center;
        flex-grow: 1;
    }

    .amenity-name {
        font-weight: 700;
        color: var(--sun-navy);
        font-size: 1rem;
        margin-bottom: 0.35rem;
    }

    .amenity-desc {
        color: #64748B;
        font-size: 0.82rem;
        line-height: 1.45;
    }

    /* ═══ STATS CREDENTIALS ═══ */
    .stats-section {
        background: linear-gradient(135deg, var(--sun-navy-deep) 0%, var(--sun-navy) 100%);
        border-top: 1px solid rgba(212, 175, 55, 0.2);
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

    .stat-number {
        font-family: 'Playfair Display', serif;
        font-size: 2.75rem;
        font-weight: 700;
        color: #FFFFFF;
        line-height: 1.1;
    }

    .stat-number span {
        background: linear-gradient(135deg, #FFFFFF, var(--sun-gold-light));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-label {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.88rem;
        font-weight: 500;
        margin-top: 0.35rem;
    }

    /* ═══ CTA SECTION ═══ */
    .cta-section {
        background: linear-gradient(135deg, #0F2540 0%, #1A3C5E 60%, #13344F 100%);
        position: relative;
        overflow: hidden;
    }

    .cta-section::after {
        content: '';
        position: absolute;
        bottom: -50px;
        right: -50px;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.18) 0%, transparent 70%);
        pointer-events: none;
    }
</style>
}

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 1. HERO SECTION -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="hero-section">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-badge-pill">
                    <i class="bi bi-star-fill text-warning"></i>
                    <span>Sun Hotel & Resort &bull; Chuẩn Mực 4 Sao Quốc Tế</span>
                </div>
                <h1 class="hero-title">
                    Trải Nghiệm Nghỉ Dưỡng<br /><span>Thượng Lưu Giữa Lòng Thành Phố</span>
                </h1>
                <p class="hero-subtitle">
                    Không gian kiến trúc tinh tế hòa quyện cùng nghệ thuật hiếu khách cao cấp. 
                    Mọi chi tiết tại Sun Hotel được chăm chút tỉ mỉ nhằm đem đến cho Quý khách kỳ nghỉ dưỡng đáng nhớ và trọn vẹn nhất.
                </p>
                <div class="d-flex gap-3 flex-wrap align-items-center">
                    <a asp-controller="Booking" asp-action="Create" class="btn-gold">
                        <i class="bi bi-calendar-check me-2"></i> Đặt Phòng Ngay
                    </a>
                    <a href="#room-types-section" class="btn-outline-gold">
                        <i class="bi bi-door-open me-2"></i> Khám Phá Hạng Phòng
                    </a>
                    <a asp-controller="Booking" asp-action="Lookup" class="text-white-50 text-decoration-none ms-md-2" style="font-size: 0.88rem;">
                        <i class="bi bi-search me-1"></i> Tra cứu đặt phòng
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-glass-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold text-white mb-0" style="font-family: 'Playfair Display', serif; font-size: 1.4rem;">
                            Đặc Quyền Nghỉ Dưỡng
                        </h4>
                        <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.72rem; font-weight: 700; border-radius: 6px;">4-STAR LUXURY</span>
                    </div>

                    <div class="hero-feature-item">
                        <div class="hero-feature-icon">
                            <i class="bi bi-water"></i>
                        </div>
                        <div>
                            <div class="text-white fw-bold" style="font-size: 0.95rem;">Hồ Bơi Vô Cực Trên Tầng Thượng</div>
                            <div class="text-white-50" style="font-size: 0.82rem; margin-top: 2px;">Tầm nhìn panorama toàn cảnh thành phố lung linh về đêm.</div>
                        </div>
                    </div>

                    <div class="hero-feature-item">
                        <div class="hero-feature-icon">
                            <i class="bi bi-cup-hot-fill"></i>
                        </div>
                        <div>
                            <div class="text-white fw-bold" style="font-size: 0.95rem;">Ẩm Thực & Thực Đơn Tại Phòng</div>
                            <div class="text-white-50" style="font-size: 0.82rem; margin-top: 2px;">Phục vụ món ăn Á - Âu và quầy bar giao tận cửa phòng 24/7.</div>
                        </div>
                    </div>

                    <div class="hero-feature-item">
                        <div class="hero-feature-icon">
                            <i class="bi bi-headset"></i>
                        </div>
                        <div>
                            <div class="text-white fw-bold" style="font-size: 0.95rem;">Cổng Dịch Vụ Digital Concierge</div>
                            <div class="text-white-50" style="font-size: 0.82rem; margin-top: 2px;">Yêu cầu hỗ trợ kỹ thuật, dọn phòng tức thì chỉ với 1 chạm.</div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center text-white-50" style="font-size: 0.82rem;">
                        <span><i class="bi bi-shield-check text-success me-1"></i> Giá cam kết tốt nhất</span>
                        <span><i class="bi bi-clock-history text-warning me-1"></i> Hỗ trợ 24/7</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 2. QUICK SEARCH BAR -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="search-section">
    <div class="container">
        <div class="search-card">
            <form asp-controller="Room" asp-action="Listing" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label"><i class="bi bi-calendar-event me-1 text-muted"></i> Ngày nhận phòng</label>
                        <input type="date" name="CheckInDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label"><i class="bi bi-calendar-check me-1 text-muted"></i> Ngày trả phòng</label>
                        <input type="date" name="CheckOutDate" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label"><i class="bi bi-door-open me-1 text-muted"></i> Hạng phòng</label>
                        <select name="RoomTypeId" class="form-select">
                            <option value="">Tất cả hạng phòng</option>
                            @foreach (var rt in roomTypes)
                            {
                                <option value="@rt.Id">@rt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label"><i class="bi bi-people me-1 text-muted"></i> Số khách</label>
                        <select name="NumGuests" class="form-select">
                            @for (int i = 1; i <= 6; i++)
                            {
                                <option value="@i">@i khách</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <button type="submit" class="btn btn-gold w-100 justify-content-center text-nowrap" style="padding: 11px 16px;">
                            <i class="bi bi-search me-2"></i> Tìm Phòng
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 3. ROOM TYPES COLLECTION -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section id="room-types-section" style="padding: 5.5rem 0 4.5rem; background: #FFFFFF;">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow">Bộ Sưu Tập Nghỉ Dưỡng</div>
            <h2 class="section-title">Hạng Phòng Tiêu Chuẩn & Thượng Hạng</h2>
            <p class="section-subtitle">
                Được thiết kế tinh tế với gam màu trang nhã, nội thất cao cấp nhập khẩu và trang thiết bị hiện đại đảm bảo giấc ngủ êm ái cho Quý khách.
            </p>
        </div>

        @if (roomTypes.Any())
        {
            <div class="row g-4">
                @foreach (var rt in roomTypes)
                {
                    var avail = availableByType.TryGetValue(rt.Id, out var a) ? a : 0;
                    <div class="col-md-6 col-lg-4">
                        <div class="hotel-room-card">
                            <div class="hotel-room-card-img-wrap">
                                @if (!string.IsNullOrEmpty(rt.ImageUrl))
                                {
                                    <img src="@rt.ImageUrl" alt="@rt.Name" class="hotel-room-card-img" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary bg-opacity-25">
                                        <i class="bi bi-building text-white" style="font-size: 2.5rem; opacity: 0.6;"></i>
                                    </div>
                                }
                                <div class="hotel-room-card-badge">
                                    <i class="bi bi-people me-1"></i> Tối đa @rt.MaxGuests khách
                                </div>
                            </div>
                            <div class="hotel-room-card-body">
                                <div>
                                    <h3 class="hotel-room-card-name">@rt.Name</h3>
                                    <p class="hotel-room-card-desc">@(rt.Description ?? "Không gian nghỉ dưỡng tiện nghi với giường nệm êm ái, bồn tắm cao cấp và ban công ngắm nhìn thành phố.")</p>
                                    <div class="hotel-room-card-meta">
                                        <span><i class="bi bi-wifi me-1 text-primary"></i> Wifi 5G</span>
                                        <span><i class="bi bi-tv me-1 text-primary"></i> Smart TV</span>
                                        <span><i class="bi bi-snow me-1 text-primary"></i> Điều hòa 2 chiều</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2">
                                    <div>
                                        <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase;">Giá mỗi đêm</div>
                                        <div class="hotel-room-card-price">
                                            @rt.BasePrice.ToString("N0") <small>VNĐ</small>
                                        </div>
                                    </div>
                                    @if (avail > 0)
                                    {
                                        <a asp-controller="Booking" asp-action="Create" asp-route-roomTypeId="@rt.Id" class="btn btn-gold btn-sm px-3 py-2">
                                            Đặt ngay <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm btn-light border text-muted disabled px-3 py-2" style="border-radius: 10px;">
                                            Tạm hết phòng
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-building text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">Đang cập nhật danh mục phòng...</p>
            </div>
        }

        <div class="text-center mt-5">
            <a asp-controller="Room" asp-action="Listing" class="btn btn-outline-dark px-4 py-2" style="border-radius: 12px; font-weight: 600; font-size: 0.92rem;">
                Xem tất cả phòng & tiện ích chi tiết <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</section>

