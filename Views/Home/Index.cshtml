                <div class="amenity-card">
                    <img src="/images/hotel-assets/amenities/spa.png" alt="Spa trị liệu" class="amenity-card-img" />
                    <div class="amenity-card-content">
                        <div class="amenity-name">Spa & Trị Liệu Thư Giãn</div>
                        <div class="amenity-desc">Liệu pháp massage thảo mộc tự nhiên, xông hơi đá muối Himalaya giúp xua tan mệt mỏi.</div>
                    </div>
                </div>
            </div>

            <!-- Gym -->
            <div class="col-md-4 col-sm-6">
                <div class="amenity-card">
                    <img src="/images/hotel-assets/amenities/gym.png" alt="Fitness Center" class="amenity-card-img" />
