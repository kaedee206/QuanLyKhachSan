@model VerifyCustomerOtpViewModel
@{
    Layout = null;
    ViewData["Title"] = "Xác Thực Mã OTP - Sun Hotel Concierge";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --sun-navy: #0B1E36;
            --sun-gold: #D4AF37;
            --sun-bg: #091524;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--sun-bg);
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(212, 175, 55, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(22, 50, 85, 0.4) 0%, transparent 50%),
                linear-gradient(180deg, #07101C 0%, #0B1E36 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            color: #E2E8F0;
        }

        .portal-card {
            background: rgba(15, 37, 64, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(212, 175, 55, 0.1);
            max-width: 480px;
            width: 100%;
            padding: 2.75rem 2.25rem;
            text-align: center;
        }

        .otp-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(212, 175, 55, 0.15);
            border: 2px solid #D4AF37;
            color: #D4AF37;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 1.25rem;
        }

        .portal-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 0.5rem;
        }

        .otp-input {
            font-family: 'Inter', monospace;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: 12px;
            text-align: center;
            background: rgba(255, 255, 255, 0.06);
            border: 2px solid rgba(212, 175, 55, 0.4);
            border-radius: 12px;
            color: #FFFFFF;
            padding: 0.75rem 1rem;
            transition: all 0.25s ease;
        }

        .otp-input:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: #D4AF37;
            color: #FFFFFF;
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.25);
            outline: none;
        }

        .btn-portal-submit {
            background: linear-gradient(135deg, #D4AF37 0%, #E8C868 100%);
            color: #0B1E36;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 0.85rem;
            font-size: 1rem;
            width: 100%;
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
            transition: all 0.25s ease;
            margin-top: 1.5rem;
        }

        .btn-portal-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(212, 175, 55, 0.45);
            background: linear-gradient(135deg, #E2C04D 0%, #F5D77F 100%);
            color: #0B1E36;
        }

        .countdown-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            font-size: 0.82rem;
            color: #D4AF37;
            margin-top: 1.25rem;
        }
    </style>
</head>
<body>

    <div class="portal-card">
        <div class="otp-icon">
            <i class="bi bi-key-fill"></i>
        </div>
        <h2 class="portal-title">Nhập Mã Xác Thực OTP</h2>
        <p class="text-muted" style="font-size: 0.88rem; margin-bottom: 1.75rem;">
            Mã OTP gồm 6 chữ số đã được gửi tới email:<br>
            <strong style="color: #D4AF37;">@Model.MaskedEmail</strong>
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 px-3 mb-3 text-start" style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); color: #86EFAC; font-size: 0.85rem; border-radius: 10px;">
                <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 text-start" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #FCA5A5; font-size: 0.85rem; border-radius: 10px;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 text-start" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #FCA5A5; font-size: 0.85rem; border-radius: 10px;">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <form asp-action="VerifyOtp" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <input asp-for="OtpCode" class="form-control otp-input" maxlength="6" autofocus placeholder="••••••" autocomplete="one-time-code" />
                <span asp-validation-for="OtpCode" class="text-danger d-block mt-2" style="font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="btn btn-portal-submit">
                <i class="bi bi-unlock-fill me-1"></i> Xác Nhận & Vào Trang Khách Hàng
            </button>
        </form>

        <div class="countdown-badge">
            <i class="bi bi-clock-history"></i>
            <span>Mã OTP hết hạn sau: <strong id="timerDisplay">10:00</strong></span>
        </div>

        <!-- Resend OTP Button with Rate Limit Cooldown -->
        <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
            <form asp-action="ResendOtp" method="post" id="resendOtpForm" class="d-inline-block">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@Model.Token" />
                <button type="submit" id="btnResendOtp" class="btn btn-sm btn-outline-warning" 
                        @(Model.ResendCooldownSeconds > 0 ? "disabled" : "") 
                        style="border-radius: 20px; padding: 7px 22px; font-size: 0.85rem; font-weight: 600;">
                    <i class="bi bi-arrow-repeat me-1"></i>
                    <span id="resendText">
                        @(Model.ResendCooldownSeconds > 0 ? $"Gửi lại mã sau ({Model.ResendCooldownSeconds}s)" : "Chưa nhận được mã? Gửi lại OTP")
                    </span>
                </button>
            </form>
            <div class="text-white-50 mt-2" style="font-size: 0.74rem;">
                <i class="bi bi-shield-check me-1 text-success"></i> Giới hạn gửi lại an toàn: tối thiểu 60 giây giữa các lần gửi.
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Login" style="color: #94A3B8; font-size: 0.82rem; text-decoration: none;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại điền lại thông tin
            </a>
        </div>
    </div>

    <script>
        var timeLeft = @Model.ExpiresInSeconds;
        var timerEl = document.getElementById("timerDisplay");

        function updateTimer() {
            if (timeLeft <= 0) {
                timerEl.textContent = "Đã hết hạn!";
                timerEl.style.color = "#EF4444";
                return;
            }
            var mins = Math.floor(timeLeft / 60);
            var secs = timeLeft % 60;
            timerEl.textContent = (mins < 10 ? "0" + mins : mins) + ":" + (secs < 10 ? "0" + secs : secs);
            timeLeft--;
        }

        updateTimer();
        setInterval(updateTimer, 1000);

        // Cooldown Countdown for Resend Button
        var resendCooldown = @Model.ResendCooldownSeconds;
        var btnResend = document.getElementById("btnResendOtp");
        var resendText = document.getElementById("resendText");

        if (resendCooldown > 0 && btnResend && resendText) {
            btnResend.setAttribute("disabled", "disabled");
            var resendInterval = setInterval(function() {
                resendCooldown--;
                if (resendCooldown <= 0) {
                    clearInterval(resendInterval);
                    btnResend.removeAttribute("disabled");
                    resendText.textContent = "Chưa nhận được mã? Gửi lại OTP";
                } else {
                    resendText.textContent = "Gửi lại mã sau (" + resendCooldown + "s)";
                }
            }, 1000);
        }

        var resendForm = document.getElementById("resendOtpForm");
        if (resendForm && btnResend) {
            resendForm.addEventListener("submit", function() {
                btnResend.setAttribute("disabled", "disabled");
                if (resendText) resendText.textContent = "Đang gửi lại mã...";
            });
        }
    </script>
</body>
</html>
