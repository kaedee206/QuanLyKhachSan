@model CustomerLoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Cổng Khách Hàng 4 Sao - Sun Hotel Concierge";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --sun-navy: #0B1E36;
            --sun-navy-light: #163255;
            --sun-gold: #D4AF37;
            --sun-gold-light: #F3E5AB;
            --sun-bg: #091524;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--sun-bg);
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(212, 175, 55, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(22, 50, 85, 0.4) 0%, transparent 50%),
                linear-gradient(180deg, #07101C 0%, #0B1E36 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            color: #E2E8F0;
        }

        .portal-card {
            background: rgba(15, 37, 64, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(212, 175, 55, 0.1);
            max-width: 520px;
            width: 100%;
            padding: 2.75rem 2.5rem;
            position: relative;
        }

        .brand-crest {
            width: 68px;
            height: 68px;
            border-radius: 18px;
            background: linear-gradient(135deg, #D4AF37, #F5D77F);
            color: var(--sun-navy);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 1.25rem;
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
        }

        .portal-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #FFFFFF;
            text-align: center;
            margin-bottom: 0.35rem;
        }

        .portal-subtitle {
            text-align: center;
            color: #94A3B8;
            font-size: 0.88rem;
            margin-bottom: 2rem;
        }

        .form-label-custom {
            font-size: 0.82rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.75px;
            color: #CBD5E1;
            margin-bottom: 0.4rem;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .input-group-custom .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #D4AF37;
            font-size: 1.1rem;
            z-index: 5;
        }

        .form-control-custom {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #FFFFFF;
            border-radius: 10px;
            padding: 0.75rem 1rem 0.75rem 2.75rem;
            font-size: 0.92rem;
            transition: all 0.25s ease;
        }

        .form-control-custom:focus {
            background: rgba(255, 255, 255, 0.09);
            border-color: #D4AF37;
            color: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #64748B;
        }

        .btn-portal-submit {
            background: linear-gradient(135deg, #D4AF37 0%, #E8C868 100%);
            color: #0B1E36;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 0.9rem;
            font-size: 1rem;
            letter-spacing: 0.5px;
            width: 100%;
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
            transition: all 0.25s ease;
            margin-top: 1rem;
        }

        .btn-portal-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(212, 175, 55, 0.45);
            background: linear-gradient(135deg, #E2C04D 0%, #F5D77F 100%);
            color: #0B1E36;
        }

        .security-badge {
            background: rgba(255, 255, 255, 0.03);
            border: 1px dashed rgba(212, 175, 55, 0.3);
            border-radius: 10px;
            padding: 0.65rem 1rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.78rem;
            color: #94A3B8;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="portal-card">
        <div class="brand-crest">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1 class="portal-title">Sun Hotel Concierge</h1>
        <p class="portal-subtitle">Cổng Thông Tin & Dịch Vụ Khách Hàng Trực Tuyến</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 mb-4" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #FCA5A5; font-size: 0.85rem; border-radius: 10px;">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 px-3 mb-4" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #A7F3D0; font-size: 0.85rem; border-radius: 10px;">
                <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-4" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #FCA5A5; font-size: 0.85rem; border-radius: 10px;">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
            </div>
        }

        <form asp-action="RequestOtp" method="post">
            @Html.AntiForgeryToken()

            <!-- 1. Mã hóa đơn / Mã đặt phòng -->
            <div class="input-group-custom">
                <label asp-for="BookingOrInvoiceCode" class="form-label-custom"></label>
                <div class="position-relative">
                    <i class="bi bi-receipt input-icon"></i>
                    <input asp-for="BookingOrInvoiceCode" class="form-control form-control-custom" placeholder="VD: BK260927001 hoặc HD001..." autocomplete="off" />
                </div>
                <span asp-validation-for="BookingOrInvoiceCode" class="text-danger" style="font-size: 0.78rem;"></span>
            </div>

            <!-- 2. Căn cước công dân (CCCD) -->
            <div class="input-group-custom">
                <label asp-for="IdNumber" class="form-label-custom"></label>
                <div class="position-relative">
                    <i class="bi bi-person-vcard input-icon"></i>
                    <input asp-for="IdNumber" class="form-control form-control-custom" placeholder="VD: 001234567890..." autocomplete="off" />
                </div>
                <span asp-validation-for="IdNumber" class="text-danger" style="font-size: 0.78rem;"></span>
            </div>

            <!-- 3. Email -->
            <div class="input-group-custom">
                <label asp-for="Email" class="form-label-custom"></label>
                <div class="position-relative">
                    <i class="bi bi-envelope-at input-icon"></i>
                    <input asp-for="Email" type="email" class="form-control form-control-custom" placeholder="Email nhận mã OTP..." autocomplete="off" />
                </div>
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.78rem;"></span>
            </div>

            <!-- 4. Số điện thoại -->
            <div class="input-group-custom">
                <label asp-for="Phone" class="form-label-custom"></label>
                <div class="position-relative">
                    <i class="bi bi-telephone input-icon"></i>
                    <input asp-for="Phone" type="tel" class="form-control form-control-custom" placeholder="Số điện thoại đăng ký phòng..." autocomplete="off" />
                </div>
                <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.78rem;"></span>
            </div>

            <button type="submit" class="btn btn-portal-submit">
                <i class="bi bi-send-check me-2"></i> Tiếp tục & Nhận mã OTP qua Email
            </button>
        </form>

        <div class="security-badge">
            <i class="bi bi-shield-check text-warning fs-5"></i>
            <div>
                <strong>Bảo mật 4 lớp & Xác thực OTP</strong><br>
                Mã xác thực một lần (OTP) 6 chữ số sẽ được gửi bảo mật tới email của Quý khách.
            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Index" style="color: #94A3B8; font-size: 0.82rem; text-decoration: none;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ khách sạn
            </a>
        </div>
    </div>

</body>
</html>
