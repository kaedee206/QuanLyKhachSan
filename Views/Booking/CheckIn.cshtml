@model PaginatedList<Booking>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Check-in";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0" style="color: #1A3C5E; font-weight: 700;">
            <i class="bi bi-box-arrow-in-right me-2" style="color: #28a745;"></i>
            Check-in
        </h4>
        <small class="text-muted">Danh sách booking đã xác nhận, sẵn sàng nhận phòng (@Model.TotalCount)</small>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size: 0.85rem;">
                <thead style="background: #f8f6f0;">
                    <tr>
                        <th class="border-0 px-4 py-2">Mã booking</th>
                        <th class="border-0 py-2">Tên khách</th>
                        <th class="border-0 py-2">SĐT</th>
                        <th class="border-0 py-2">Phòng</th>
                        <th class="border-0 py-2">Loại phòng</th>
                        <th class="border-0 py-2">Nhận phòng</th>
                        <th class="border-0 py-2">Trả phòng</th>
                        <th class="border-0 py-2">Số khách</th>
                        <th class="border-0 py-2 text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td class="px-4">
                                <a asp-action="Detail" asp-route-id="@b.Id" style="color: #1A3C5E; font-weight: 600; text-decoration: none;">@b.BookingCode</a>
                            </td>
                            <td class="fw-bold">@b.GuestName</td>
                            <td>@b.Phone</td>
                            <td>
                                <span class="badge bg-light text-dark" style="font-size: 0.8rem;">@(b.Room?.RoomNumber ?? "—")</span>
                            </td>
                            <td>@b.RoomType?.Name</td>
                            <td>@b.CheckInDate.ToString("dd/MM/yyyy")</td>
                            <td>@b.CheckOutDate.ToString("dd/MM/yyyy")</td>
                            <td>@b.NumGuests</td>
                            <td class="text-end pe-4">
                                <form asp-action="CheckIn" asp-route-code="@b.BookingCode" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm" style="background: #28a745; color: white; border-radius: 8px; font-size: 0.78rem;" onclick="return confirm('Xác nhận check-in cho @b.GuestName?');">
                                        <i class="bi bi-box-arrow-in-right"></i> Check-in
                                    </button>
                                </form>
                                <a asp-action="Detail" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; font-size: 0.75rem;" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-check-circle" style="font-size: 2.5rem; color: #28a745;"></i>
                                <div class="mt-2">Không có booking nào cần check-in</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ═══ PAGINATION ═══ -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-center">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="CheckIn" asp-route-Page="@(Model.Page - 1)" style="border-radius: 6px; margin: 0 2px;">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="CheckIn" asp-route-Page="@i" style="border-radius: 6px; margin: 0 2px; @(i == Model.Page ? "background: #1A3C5E; border-color: #1A3C5E;" : "")">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="CheckIn" asp-route-Page="@(Model.Page + 1)" style="border-radius: 6px; margin: 0 2px;">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
