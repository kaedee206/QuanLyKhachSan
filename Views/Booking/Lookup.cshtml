@model BookingLookupViewModel
@{
    ViewData["Title"] = "Tra cứu đặt phòng - Sun Hotel";
}

@section Styles {
<style>
    .lookup-hero {
        background: linear-gradient(135deg, #0F2540 0%, #1A3C5E 50%, #2E8B8B 100%);
        padding: 3rem 0 2rem;
    }
    .lookup-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 2rem;
        color: white;
    }
    .lookup-card {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 10px 40px rgba(15,37,64,0.1);
        border: 1px solid rgba(0,0,0,0.05);
        max-width: 520px;
        margin: 0 auto;
    }
    .lookup-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: linear-gradient(135deg, #D4AF37, #F0D060);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #1A3C5E;
        margin: 0 auto 1.5rem;
    }
    .form-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #1A3C5E;
    }
    .form-control {
        border: 1px solid #e0d8cc;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 0.9rem;
    }
    .form-control:focus {
        border-color: #D4AF37;
        box-shadow: 0 0 0 3px rgba(212,175,55,0.15);
    }
    .btn-lookup {
        background: linear-gradient(135deg, #D4AF37, #F0D060);
        color: #1A3C5E;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        padding: 12px;
        width: 100%;
        font-size: 0.95rem;
        transition: all 0.3s;
    }
    .btn-lookup:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(212,175,55,0.35);
        color: #1A3C5E;
    }
    .info-box {
        background: #F5F0E8;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        border: 1px solid rgba(212,175,55,0.15);
    }
</style>
}

<!-- ═══ HERO ═══ -->
<section class="lookup-hero">
    <div class="container">
        <h1 class="lookup-title mb-1">
            <i class="bi bi-search me-2" style="color: #D4AF37;"></i>Tra cứu đặt phòng
        </h1>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.95rem;">Kiểm tra thông tin booking của bạn</p>
    </div>
</section>

<section style="background: #F5F0E8; padding: 3rem 0 5rem;">
    <div class="container">
        <div class="lookup-card">
            <div class="lookup-icon">
                <i class="bi bi-qr-code-scan"></i>
            </div>

            <h5 style="font-family: 'Playfair Display', serif; font-weight: 700; color: #0F2540; text-align: center; margin-bottom: 0.5rem;">
                Tra cứu booking
            </h5>
            <p style="text-align: center; color: #6b7280; font-size: 0.88rem; margin-bottom: 1.75rem;">
                Nhập mã đặt phòng và số điện thoại để xem thông tin chi tiết
            </p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.85rem; border-radius: 10px;">
                    <i class="bi bi-exclamation-circle me-1"></i> @TempData["Error"]
                </div>
            }

            <form asp-controller="Booking" asp-action="Lookup" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.85rem;"></div>

                <div class="mb-3">
                    <label asp-for="BookingCode" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: #F5F0E8; border-color: #e0d8cc; color: #D4AF37; border-radius: 10px 0 0 10px;">
                            <i class="bi bi-hash"></i>
                        </span>
                        <input asp-for="BookingCode" class="form-control" placeholder="VD: BK000123" style="border-radius: 0 10px 10px 0;" />
                    </div>
                    <span asp-validation-for="BookingCode" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Phone" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: #F5F0E8; border-color: #e0d8cc; color: #D4AF37; border-radius: 10px 0 0 10px;">
                            <i class="bi bi-telephone"></i>
                        </span>
                        <input asp-for="Phone" class="form-control" placeholder="VD: 0912345678" style="border-radius: 0 10px 10px 0;" />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <button type="submit" class="btn btn-lookup">
                    <i class="bi bi-search me-1"></i> Tra cứu
                </button>
            </form>

            <div class="info-box mt-4">
                <h6 style="font-size: 0.8rem; font-weight: 700; color: #D4AF37; margin-bottom: 0.5rem;">
                    <i class="bi bi-lightbulb me-1"></i> Hướng dẫn
                </h6>
                <ul style="font-size: 0.82rem; color: #6b7280; margin: 0; padding-left: 1.2rem;">
                    <li>Mã đặt phòng được gửi qua email hoặc tin nhắn khi đặt phòng thành công</li>
                    <li>Số điện thoại phải trùng với số đã dùng khi đặt phòng</li>
                    <li>Nếu gặp vấn đề, vui lòng gọi hotline: <strong>0123 456 789</strong></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
