@model BookingDetailViewModel
@using QuanLyKhachSan.Models.Enums
@{
    ViewData["Title"] = "Xác nhận đặt phòng - Sun Hotel";
    var booking = Model.Booking;
    var invoice = Model.Invoice;
    var isPaid = invoice?.PaymentStatus == PaymentStatus.Paid;
    var nights = booking.CheckOutDate.DayNumber - booking.CheckInDate.DayNumber;
    var totalAmount = booking.TotalAmount + Model.Services.Sum(s => s.TotalAmount);
}
@Html.AntiForgeryToken()

@section Styles {
<style>
    .conf-hero {
        background: linear-gradient(135deg, #0F2540 0%, #1A3C5E 50%, #2E8B8B 100%);
        padding: 2.5rem 0 2rem;
    }
    .state-card {
        background: white;
        border-radius: 20px;
        padding: 2.5rem 2rem;
        box-shadow: 0 10px 40px rgba(15,37,64,0.1);
        border: 1px solid rgba(0,0,0,0.05);
        text-align: center;
        margin-bottom: 1.5rem;
    }
    .state-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
        font-size: 2.2rem;
    }
    .state-icon.pending {
        background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(245,158,11,0.05));
        color: #d97706;
    }
    .state-icon.paid {
        background: linear-gradient(135deg, rgba(16,185,129,0.15), rgba(16,185,129,0.05));
        color: #10b981;
    }
    .booking-code {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #D4AF37, #F0D060);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 3px;
    }
    .detail-card {
        background: white;
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.05);
        margin-bottom: 1.25rem;
    }
    .detail-card-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1rem;
        color: #0F2540;
        margin-bottom: 1.1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .detail-card-title i { color: #D4AF37; }
    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.55rem 0;
        border-bottom: 1px solid #f3f0ea;
        font-size: 0.88rem;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #6b7280; }
    .detail-value { font-weight: 600; color: #0F2540; text-align: right; }
    .btn-pay {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        font-weight: 700;
        font-size: 1.05rem;
        border: none;
        border-radius: 14px;
        padding: 15px 32px;
        width: 100%;
        transition: all 0.3s;
        position: relative;
    }
    .btn-pay:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16,185,129,0.4);
        color: white;
    }
    .btn-pay:disabled { opacity: 0.75; cursor: not-allowed; }
    .spinner-border-sm { width: 1rem; height: 1rem; }
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .badge-pending { background: rgba(245,158,11,0.12); color: #b45309; }
    .badge-paid    { background: rgba(16,185,129,0.12); color: #047857; }
    .badge-confirmed { background: rgba(16,185,129,0.1); color: #059669; }
    .btn-outline-muted {
        border: 1.5px solid #e5e7eb;
        color: #6b7280;
        border-radius: 10px;
        background: white;
        font-size: 0.88rem;
        padding: 9px 18px;
        transition: all 0.2s;
    }
    .btn-outline-muted:hover { border-color: #0F2540; color: #0F2540; }
    @@media print {
        nav, footer, .no-print { display: none !important; }
        .detail-card, .state-card { box-shadow: none !important; border: 1px solid #ddd !important; }
    }
</style>
}

<section class="conf-hero">
    <div class="container">
        <h1 style="font-family:'Playfair Display',serif;font-weight:700;font-size:1.8rem;color:white;margin-bottom:0.2rem;">
            @if (isPaid)
            {
                <i class="bi bi-patch-check-fill me-2" style="color:#10b981;"></i>
                <text>Đặt phòng &amp; Thanh toán</text>
            }
            else
            {
                <i class="bi bi-calendar-check me-2" style="color:#D4AF37;"></i>
                <text>Đặt phòng thành công</text>
            }
        </h1>
        <p style="color:rgba(255,255,255,0.65);font-size:0.88rem;">Mã booking: <strong style="color:#D4AF37;">@booking.BookingCode</strong></p>
    </div>
</section>

<section style="background:#F5F0E8;padding:2rem 0 4rem;">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 rounded-3 mb-3" style="background:rgba(16,185,129,0.1);color:#047857;">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-warning border-0 rounded-3 mb-3">
                <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 rounded-3 mb-3">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            </div>
        }

        <div class="row g-4">
            <!-- Left: status + details -->
            <div class="col-lg-8">

                <!-- State Banner -->
                <div class="state-card">
                    @if (isPaid)
                    {
                        <div class="state-icon paid">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <h4 style="font-family:'Playfair Display',serif;font-weight:700;color:#0F2540;margin-bottom:0.4rem;">
                            Thanh toán hoàn tất!
                        </h4>
                        <p style="color:#6b7280;font-size:0.9rem;margin-bottom:1rem;">
                            Cảm ơn bạn đã đặt phòng. Hẹn gặp bạn tại Sun Hotel!
                        </p>
                        <div class="booking-code">@booking.BookingCode</div>
                        <p style="color:#6b7280;font-size:0.8rem;margin-top:0.6rem;">
                            <i class="bi bi-envelope me-1"></i> Email xác nhận đã được gửi đến <strong>@booking.Email</strong>
                        </p>
                    }
                    else
                    {
                        <div class="state-icon pending">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <h4 style="font-family:'Playfair Display',serif;font-weight:700;color:#0F2540;margin-bottom:0.4rem;">
                            Chờ thanh toán
                        </h4>
                        <p style="color:#6b7280;font-size:0.9rem;margin-bottom:1rem;">
                            Booking đã được tạo. Vui lòng hoàn tất thanh toán để xác nhận phòng.
                        </p>
                        <div class="booking-code">@booking.BookingCode</div>
                    }
                </div>

                <!-- Booking detail -->
                <div class="detail-card">
                    <h5 class="detail-card-title">
                        <i class="bi bi-calendar-check"></i> Thông tin đặt phòng
                    </h5>
                    <div class="detail-row">
                        <span class="detail-label">Khách hàng</span>
                        <span class="detail-value">@booking.GuestName</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Số điện thoại</span>
                        <span class="detail-value">@booking.Phone</span>
                    </div>
                    @if (!string.IsNullOrEmpty(booking.Email))
                    {
                        <div class="detail-row">
                            <span class="detail-label">Email</span>
                            <span class="detail-value" style="font-size:0.82rem;">@booking.Email</span>
                        </div>
                    }
                    <div class="detail-row">
                        <span class="detail-label">Loại phòng</span>
                        <span class="detail-value">@booking.RoomType?.Name</span>
                    </div>
                    @if (booking.Room != null)
                    {
                        <div class="detail-row">
                            <span class="detail-label">Số phòng</span>
                            <span class="detail-value">@booking.Room.RoomNumber</span>
                        </div>
                    }
                    <div class="detail-row">
                        <span class="detail-label">Nhận phòng</span>
                        <span class="detail-value">@booking.CheckInDate.ToString("dd/MM/yyyy") <span style="color:#9ca3af;font-weight:400;">14:00</span></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Trả phòng</span>
                        <span class="detail-value">@booking.CheckOutDate.ToString("dd/MM/yyyy") <span style="color:#9ca3af;font-weight:400;">12:00</span></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Số đêm / Số khách</span>
                        <span class="detail-value">@nights đêm &nbsp;·&nbsp; @booking.NumGuests khách</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Trạng thái booking</span>
                        <span class="detail-value">
                            @switch (booking.Status)
                            {
                                case BookingStatus.Pending:
                                    <span class="status-badge badge-pending"><i class="bi bi-clock"></i> Chờ thanh toán</span>
                                    break;
                                case BookingStatus.Confirmed:
                                    <span class="status-badge badge-confirmed"><i class="bi bi-check-circle"></i> Chờ nhận phòng</span>
                                    break;
                                case BookingStatus.CheckedIn:
                                    <span class="status-badge" style="background:rgba(59,130,246,0.1);color:#2563eb;"><i class="bi bi-box-arrow-in-right"></i> Đã check-in</span>
                                    break;
                                case BookingStatus.CheckedOut:
                                    <span class="status-badge" style="background:rgba(107,114,128,0.1);color:#4b5563;"><i class="bi bi-box-arrow-right"></i> Đã check-out</span>
                                    break;
                                case BookingStatus.Cancelled:
                                    <span class="status-badge" style="background:rgba(239,68,68,0.1);color:#dc2626;"><i class="bi bi-x-circle"></i> Đã hủy</span>
                                    break;
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Thanh toán</span>
                        <span class="detail-value">
                            @if (isPaid)
                            {
                                <span class="status-badge badge-paid"><i class="bi bi-patch-check-fill"></i> Đã thanh toán</span>
                            }
                            else
                            {
                                <span class="status-badge badge-pending"><i class="bi bi-hourglass-split"></i> Chưa thanh toán</span>
                            }
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(booking.Notes))
                    {
                        <div class="detail-row">
                            <span class="detail-label">Ghi chú</span>
                            <span class="detail-value">@booking.Notes</span>
                        </div>
                    }
                </div>

            </div>

            <!-- Right: payment + summary -->
            <div class="col-lg-4">

                <!-- Price summary -->
                <div class="detail-card">
                    <h5 class="detail-card-title"><i class="bi bi-receipt"></i> Chi phí</h5>
                    <div class="detail-row">
                        <span class="detail-label">Tiền phòng (@nights đêm)</span>
                        <span class="detail-value">@booking.TotalAmount.ToString("N0")₫</span>
                    </div>
                    @if (Model.Services.Any())
                    {
                        <div class="detail-row">
                            <span class="detail-label">Dịch vụ</span>
                            <span class="detail-value">@Model.Services.Sum(s => s.TotalAmount).ToString("N0")₫</span>
                        </div>
                    }
                    <hr style="border-color:#f3f0ea;margin:0.5rem 0;" />
                    <div class="detail-row" style="border-bottom:none;">
                        <span style="font-weight:700;color:#0F2540;">Tổng cộng</span>
                        <span style="font-family:'Playfair Display',serif;font-weight:700;font-size:1.3rem;color:#D4AF37;">
                            @totalAmount.ToString("N0")₫
                        </span>
                    </div>
                </div>

                <!-- Payment / Actions block -->
                <div class="detail-card no-print">
                    @if (isPaid)
                    {
                        <!-- Paid state -->
                        <div style="text-align:center;padding:0.5rem 0 1rem;">
                            <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(16,185,129,0.05));display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                                <i class="bi bi-patch-check-fill" style="font-size:1.8rem;color:#10b981;"></i>
                            </div>
                            <div style="font-weight:700;color:#047857;font-size:1rem;margin-bottom:0.25rem;">Thanh toán hoàn tất</div>
                            <div style="font-size:0.8rem;color:#6b7280;">Chờ nhận phòng lúc 14:00</div>
                        </div>
                        <hr style="border-color:#f3f0ea;" />
                        <div class="d-grid gap-2 mt-2">
                            <button onclick="window.print()" class="btn btn-outline-muted">
                                <i class="bi bi-printer me-1"></i> In xác nhận
                            </button>
                            <a asp-controller="Booking" asp-action="Lookup" class="btn btn-outline-muted text-center">
                                <i class="bi bi-search me-1"></i> Tra cứu booking
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-muted text-center">
                                <i class="bi bi-house me-1"></i> Trang chủ
                            </a>
                        </div>
                    }
                    else if (booking.Status == BookingStatus.Pending || booking.Status == BookingStatus.Confirmed)
                    {
                        <!-- Unpaid state: payment button -->
                        <h5 class="detail-card-title"><i class="bi bi-credit-card"></i> Thanh toán</h5>
                        <p style="font-size:0.83rem;color:#6b7280;margin-bottom:1.25rem;">
                            Quét mã QR qua ứng dụng ngân hàng. Hỗ trợ 40+ ngân hàng Việt Nam.
                        </p>
                        <button id="btn-quickpay" class="btn btn-pay" onclick="doQuickPay('@booking.BookingCode')">
                            <i class="bi bi-qr-code-scan me-2"></i>
                            <span id="qp-text">Thanh toán QR ngay</span>
                            <span id="qp-spinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                        </button>
                        <p style="font-size:0.75rem;color:#9ca3af;text-align:center;margin-top:0.75rem;">
                            <i class="bi bi-shield-lock me-1"></i>Bảo mật bởi SePay &amp; ngân hàng
                        </p>
                        <hr style="border-color:#f3f0ea;margin:1rem 0;" />
                        <div class="d-grid gap-2">
                            <button onclick="window.print()" class="btn btn-outline-muted">
                                <i class="bi bi-printer me-1"></i> In thông tin
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-muted text-center">
                                <i class="bi bi-house me-1"></i> Trang chủ
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            <button onclick="window.print()" class="btn btn-outline-muted">
                                <i class="bi bi-printer me-1"></i> In thông tin
                            </button>
                            <a asp-controller="Booking" asp-action="Lookup" class="btn btn-outline-muted text-center">
                                <i class="bi bi-search me-1"></i> Tra cứu khác
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-muted text-center">
                                <i class="bi bi-house me-1"></i> Trang chủ
                            </a>
                        </div>
                    }
                </div>

                <!-- Info box -->
                <div style="background:#F5F0E8;border-radius:12px;padding:1rem 1.25rem;border:1px solid rgba(212,175,55,0.2);">
                    <h6 style="font-size:0.8rem;font-weight:700;color:#D4AF37;margin-bottom:0.5rem;">
                        <i class="bi bi-info-circle me-1"></i> Lưu ý
                    </h6>
                    <ul style="font-size:0.8rem;color:#6b7280;margin:0;padding-left:1.2rem;">
                        <li>Check-in: <strong>14:00</strong> | Check-out: <strong>12:00</strong></li>
                        <li>Mang theo CMND/CCCD khi check-in</li>
                        <li>Hotline: <strong>0123 456 789</strong></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    function doQuickPay(bookingCode) {
        var btn = document.getElementById('btn-quickpay');
        var txt = document.getElementById('qp-text');
        var spin = document.getElementById('qp-spinner');

        btn.disabled = true;
        txt.textContent = 'Đang khởi tạo...';
        spin.classList.remove('d-none');

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('@Url.Action("QuickPay", "Payment")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'bookingCode=' + encodeURIComponent(bookingCode)
        })
        .then(function(r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
        })
        .then(function(data) {
            if (data.success && data.checkoutUrl) {
                txt.textContent = 'Đang chuyển hướng...';
                window.location.href = data.checkoutUrl;
            } else {
                btn.disabled = false;
                txt.textContent = 'Thanh toán QR ngay';
                spin.classList.add('d-none');
                alert(data.message || 'Lỗi khởi tạo thanh toán. Vui lòng thử lại.');
            }
        })
        .catch(function(err) {
            btn.disabled = false;
            txt.textContent = 'Thanh toán QR ngay';
            spin.classList.add('d-none');
            alert('Lỗi kết nối: ' + err.message);
        });
    }

    // Auto-poll khi TempData Info (đang xử lý) — reload trang sau mỗi 5s tối đa 12 lần
    @if (!isPaid && TempData["Info"] != null)
    {
        <text>
    (function() {
        var bookingCode = '@booking.BookingCode';
        var attempts = 0;
        var maxAttempts = 12;
        var interval = setInterval(function() {
            attempts++;
            fetch('@Url.Action("CheckPaymentStatus", "Payment")?bookingCode=' + encodeURIComponent(bookingCode))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.paid) {
                        clearInterval(interval);
                        window.location.reload();
                    } else if (attempts >= maxAttempts) {
                        clearInterval(interval);
                    }
                })
                .catch(function() { if (attempts >= maxAttempts) clearInterval(interval); });
        }, 5000);
    })();
        </text>
    }
</script>
}
