@model PaginatedList<User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Người dùng";
    var search = ViewBag.Search as string ?? "";
    var roleFilter = ViewBag.RoleFilter as UserRole?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0" style="color: #1A3C5E; font-weight: 700;">
            <i class="bi bi-people me-2" style="color: #D4AF37;"></i>
            Quản lý Người dùng
        </h4>
        <small class="text-muted">Tổng cộng @Model.TotalCount người dùng</small>
    </div>
    <a asp-action="Create" class="btn btn-sm" style="background: linear-gradient(135deg, #D4AF37, #F0D060); color: #1A3C5E; font-weight: 600; border-radius: 8px;">
        <i class="bi bi-plus-lg"></i> Thêm người dùng
    </a>
</div>

<!-- ═══ FILTER BAR ═══ -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body py-3 px-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" style="font-size: 0.78rem; color: #6c757d;">Tìm kiếm</label>
                <input type="text" name="Search" value="@search" class="form-control form-control-sm" placeholder="Tên, username, email, SĐT..." style="border-radius: 8px;" />
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-size: 0.78rem; color: #6c757d;">Vai trò</label>
                <select name="RoleFilter" class="form-select form-select-sm" style="border-radius: 8px;">
                    <option value="">Tất cả</option>
                    <option value="@UserRole.Customer" selected="@(roleFilter == UserRole.Customer)">Khách hàng (Customer)</option>
                    <option value="@UserRole.Admin" selected="@(roleFilter == UserRole.Admin)">Admin (Toàn quyền)</option>
                    <option value="@UserRole.Manager" selected="@(roleFilter == UserRole.Manager)">Manager (Quản lý)</option>
                    <option value="@UserRole.Receptionist" selected="@(roleFilter == UserRole.Receptionist)">Receptionist (Lễ tân)</option>
                    <option value="@UserRole.Housekeeping" selected="@(roleFilter == UserRole.Housekeeping)">Housekeeping (Buồng phòng)</option>
                    <option value="@UserRole.Maintenance" selected="@(roleFilter == UserRole.Maintenance)">Maintenance (Kỹ thuật & Bảo trì)</option>
                    <option value="@UserRole.Kitchen" selected="@(roleFilter == UserRole.Kitchen)">Kitchen (Nhân viên Bếp)</option>
                    <option value="@UserRole.Bar" selected="@(roleFilter == UserRole.Bar)">Bar (Nhân viên Bar)</option>
                    <option value="@UserRole.Inventory" selected="@(roleFilter == UserRole.Inventory)">Inventory (Quản lý Kho & Vật tư)</option>
                </select>
            </div>
            <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-sm" style="background: #1A3C5E; color: white; border-radius: 8px;">
                    <i class="bi bi-search"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;">
                    <i class="bi bi-x-lg"></i> Xóa lọc
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ═══ USERS TABLE ═══ -->
<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size: 0.85rem;">
                <thead style="background: #f8f6f0;">
                    <tr>
                        <th class="border-0 px-4 py-2">Username</th>
                        <th class="border-0 py-2">Họ tên</th>
                        <th class="border-0 py-2">Vai trò</th>
                        <th class="border-0 py-2">Email</th>
                        <th class="border-0 py-2">SĐT</th>
                        <th class="border-0 py-2 text-center">Trạng thái</th>
                        <th class="border-0 py-2 text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        var roleBadge = u.Role switch
                        {
                            UserRole.Customer => "bg-dark",
                            UserRole.Admin => "bg-danger",
                            UserRole.Manager => "bg-primary",
                            UserRole.Receptionist => "bg-info text-dark",
                            UserRole.Housekeeping => "bg-warning text-dark",
                            UserRole.Maintenance => "bg-secondary",
                            UserRole.Kitchen => "bg-success",
                            UserRole.Bar => "bg-purple text-white",
                            UserRole.Inventory => "bg-dark text-warning",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td class="px-4 fw-bold" style="color: #1A3C5E;">@u.Username</td>
                            <td>@u.FullName</td>
                            <td><span class="badge @roleBadge" style="font-size: 0.72rem;">@u.Role</span></td>
                            <td>@(u.Email ?? "—")</td>
                            <td>@(u.Phone ?? "—")</td>
                            <td class="text-center">
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success" style="font-size: 0.72rem;">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary" style="font-size: 0.72rem;">Ngừng</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" style="font-size: 0.75rem; border-radius: 6px;" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ResetPassword" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Reset mật khẩu cho @u.Username?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning" style="font-size: 0.75rem; border-radius: 6px;" title="Reset mật khẩu">
                                            <i class="bi bi-key"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Hành động này sẽ XÓA VĨNH VIỄN tài khoản người dùng @u.Username khỏi hệ thống. Bạn có chắc chắn không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.75rem; border-radius: 6px;" title="Xóa vĩnh viễn">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                <div class="mt-2">Không tìm thấy người dùng nào</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ═══ PAGINATION ═══ -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-center">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Search="@search" asp-route-RoleFilter="@roleFilter" asp-route-Page="@(Model.Page - 1)" style="border-radius: 6px; margin: 0 2px;">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-Search="@search" asp-route-RoleFilter="@roleFilter" asp-route-Page="@i" style="border-radius: 6px; margin: 0 2px; @(i == Model.Page ? "background: #1A3C5E; border-color: #1A3C5E;" : "")">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Search="@search" asp-route-RoleFilter="@roleFilter" asp-route-Page="@(Model.Page + 1)" style="border-radius: 6px; margin: 0 2px;">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
