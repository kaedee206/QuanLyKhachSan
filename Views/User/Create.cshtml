@model CreateUserViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0" style="color: #1A3C5E; font-weight: 700;">
            <i class="bi bi-person-plus me-2" style="color: #D4AF37;"></i>
            Thêm Người dùng
        </h4>
        <small class="text-muted">Tạo tài khoản nhân viên mới</small>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <h6 class="mb-3" style="color: #1A3C5E; font-weight: 700; border-bottom: 2px solid #D4AF37; padding-bottom: 8px;">
                        <i class="bi bi-shield-lock me-2"></i>Thông tin đăng nhập
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <input asp-for="Username" class="form-control" style="border-radius: 8px;" placeholder="VD: nhanvien01" />
                            <span asp-validation-for="Username" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <input asp-for="Password" class="form-control" style="border-radius: 8px;" placeholder="Tối thiểu 8 ký tự" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                    </div>

                    <h6 class="mb-3" style="color: #1A3C5E; font-weight: 700; border-bottom: 2px solid #D4AF37; padding-bottom: 8px;">
                        <i class="bi bi-person me-2"></i>Thông tin cá nhân
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <input asp-for="FullName" class="form-control" style="border-radius: 8px;" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <select asp-for="Role" class="form-select" style="border-radius: 8px;">
                                <option value="@UserRole.Customer">Khách hàng (Customer)</option>
                                <option value="@UserRole.Receptionist">Lễ tân (Receptionist)</option>
                                <option value="@UserRole.Housekeeping">Buồng phòng (Housekeeping)</option>
                                <option value="@UserRole.Maintenance">Bảo trì (Maintenance)</option>
                                <option value="@UserRole.Kitchen">Nhân viên Bếp (Kitchen)</option>
                                <option value="@UserRole.Bar">Nhân viên Bar (Bar)</option>
                                <option value="@UserRole.Inventory">Quản lý Kho & Vật tư (Inventory)</option>
                                <option value="@UserRole.Manager">Quản lý (Manager)</option>
                                <option value="@UserRole.Admin">Quản trị (Admin - Quyền hạn cao nhất)</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <input asp-for="Email" class="form-control" style="border-radius: 8px;" placeholder="email@example.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label" style="font-size: 0.85rem; font-weight: 600;"></label>
                            <input asp-for="Phone" class="form-control" style="border-radius: 8px;" placeholder="0901234567" />
                            <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.78rem;"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn" style="background: linear-gradient(135deg, #D4AF37, #F0D060); color: #1A3C5E; font-weight: 600; border-radius: 8px; padding: 10px 30px;">
                            <i class="bi bi-check-lg"></i> Tạo tài khoản
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px; padding: 10px 30px;">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
