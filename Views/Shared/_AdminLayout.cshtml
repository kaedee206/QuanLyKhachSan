@{
    Layout = "_Layout";
    ViewData["Layout"] = "Admin";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff";
    var userFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Nhân viên";
}

<style>
    :root {
        --sun-navy: #0B192C;
        --sun-navy-light: #132238;
        --sun-navy-surface: #1E293B;
        --sun-gold: #D4AF37;
        --sun-gold-hover: #E5C358;
        --sun-gold-muted: rgba(212, 175, 55, 0.15);
        --sun-bg: #F8FAFC;
        --sun-card-bg: #FFFFFF;
        --sun-border: #E2E8F0;
        --sun-text-primary: #0F172A;
        --sun-text-secondary: #475569;
        --sun-text-muted: #94A3B8;
        --sun-radius: 12px;
        --sun-radius-sm: 8px;
        --sun-shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --sun-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    }

    body {
        background-color: var(--sun-bg);
        color: var(--sun-text-primary);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
    }

    /* ═══ SIDEBAR NAVIGATION ═══ */
    .admin-wrapper {
        display: flex;
        min-height: 100vh;
        background-color: var(--sun-bg);
    }

    .admin-sidebar {
        width: 270px;
        background: var(--sun-navy);
        color: #F8FAFC;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        z-index: 100;
        transition: all 0.3s ease;
    }

    .admin-sidebar::-webkit-scrollbar {
        width: 5px;
    }
    .admin-sidebar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 10px;
    }

    .sidebar-brand {
        padding: 1.25rem 1.25rem 1rem;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sidebar-brand-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, #D4AF37, #F5D77F);
        color: var(--sun-navy);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
    }

    .sidebar-brand-text {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1.2rem;
        color: #FFFFFF;
        letter-spacing: -0.3px;
        line-height: 1.2;
    }

    .sidebar-brand-sub {
        font-family: 'Inter', sans-serif;
        font-size: 0.65rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--sun-gold);
        font-weight: 600;
    }

    .nav-section-title {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #64748B;
        padding: 1.25rem 1rem 0.4rem;
    }

    .admin-nav-link {
        color: #94A3B8;
        padding: 0.65rem 0.9rem;
        border-radius: var(--sun-radius-sm);
        margin: 2px 0.5rem;
        font-size: 0.86rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        transition: all 0.18s ease-in-out;
        border: 1px solid transparent;
    }

    .admin-nav-link:hover {
        color: #FFFFFF;
        background: rgba(255, 255, 255, 0.05);
    }

    .admin-nav-link.active {
        color: #FFFFFF;
        background: var(--sun-navy-surface);
        border: 1px solid rgba(212, 175, 55, 0.3);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .admin-nav-link .nav-icon {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        color: #94A3B8;
        background: rgba(255, 255, 255, 0.04);
        transition: all 0.18s ease-in-out;
        flex-shrink: 0;
    }

    .admin-nav-link:hover .nav-icon {
        color: var(--sun-gold);
        background: rgba(212, 175, 55, 0.12);
    }

    .admin-nav-link.active .nav-icon {
        color: #0F172A;
        background: var(--sun-gold);
    }

    .nav-badge {
        font-size: 0.7rem;
        padding: 2px 7px;
        border-radius: 999px;
        margin-left: auto;
        font-weight: 600;
    }

    /* User Profile Card in Sidebar */
    .sidebar-user-card {
        margin: auto 0.75rem 1rem;
        background: var(--sun-navy-light);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--sun-radius);
        padding: 0.9rem;
    }

    .role-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 999px;
    }

    /* ═══ MAIN CONTENT AREA ═══ */
    .admin-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow-x: hidden;
    }

    /* Top Navbar */
    .admin-topbar {
        background: #FFFFFF;
        border-bottom: 1px solid var(--sun-border);
        padding: 0.85rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 90;
        box-shadow: var(--sun-shadow-sm);
    }

    .live-clock-badge {
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--sun-navy);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .status-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10B981;
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
        animation: pulseAnimation 2s infinite;
    }

    @@keyframes pulseAnimation {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .admin-content-body {
        padding: 1.5rem 1.75rem 2.5rem;
        flex: 1;
    }

    /* Common Card Styles */
    .purity-card, .pms-card {
        background: var(--sun-card-bg);
        border-radius: var(--sun-radius);
        border: 1px solid var(--sun-border);
        box-shadow: var(--sun-shadow-sm);
        transition: all 0.2s ease;
    }

    .pms-card-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--sun-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #FFFFFF;
        border-radius: var(--sun-radius) var(--sun-radius) 0 0;
    }

    .pms-card-body {
        padding: 1.25rem;
    }
</style>

<div class="admin-wrapper">
    <!-- ═══ SIDEBAR NAVIGATION ═══ -->
    <aside class="admin-sidebar" id="adminSidebar">
        <!-- Brand Header -->
        <a asp-controller="Admin" asp-action="Index" class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="bi bi-sun-fill"></i>
            </div>
            <div>
                <div class="sidebar-brand-text">Sun Hotel</div>
                <div class="sidebar-brand-sub">PMS &bull; Property Management</div>
            </div>
        </a>

        <!-- Menu Navigation -->
        <div class="nav flex-column py-2">
            <!-- 1. TỔNG QUAN -->
            <div class="nav-section-title">Tổng quan</div>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Receptionist"))
            {
                <a asp-controller="Admin" asp-action="Index" class="admin-nav-link" data-controller="Admin" data-action="Index">
                    <div class="nav-icon"><i class="bi bi-speedometer2"></i></div>
                    <span>Dashboard PMS</span>
                </a>
            }

            <!-- 2. TIẾP ĐÓN & ĐẶT PHÒNG -->
            @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Receptionist"))
            {
                <div class="nav-section-title">Tiếp đón & Đặt phòng</div>
                <a asp-controller="Room" asp-action="Index" class="admin-nav-link" data-controller="Room" data-action="Index">
                    <div class="nav-icon"><i class="bi bi-grid-3x3-gap"></i></div>
                    <span>Sơ đồ phòng</span>
                </a>
                <a asp-controller="Booking" asp-action="Index" class="admin-nav-link" data-controller="Booking" data-action="Index">
                    <div class="nav-icon"><i class="bi bi-calendar2-check"></i></div>
                    <span>Danh sách Booking</span>
                </a>
                <a asp-controller="Booking" asp-action="CheckIn" class="admin-nav-link" data-controller="Booking" data-action="CheckIn">
                    <div class="nav-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                    <span>Nhận phòng (Check-in)</span>
                </a>
                <a asp-controller="Booking" asp-action="CheckOut" class="admin-nav-link" data-controller="Booking" data-action="CheckOut">
                    <div class="nav-icon"><i class="bi bi-box-arrow-right"></i></div>
                    <span>Trả phòng (Check-out)</span>
                </a>
                <a asp-controller="Service" asp-action="Index" class="admin-nav-link" data-controller="Service" data-action="Index">
                    <div class="nav-icon"><i class="bi bi-cup-hot"></i></div>
                    <span>Dịch vụ & Minibar</span>
                </a>
                <a asp-controller="Invoice" asp-action="Index" class="admin-nav-link" data-controller="Invoice" data-action="Index">
                    <div class="nav-icon"><i class="bi bi-receipt"></i></div>
                    <span>Hóa đơn & Thu ngân</span>
                </a>
            }

            <!-- 3. BUỒNG PHÒNG & KỸ THUẬT -->
            <div class="nav-section-title">Vận hành & Kỹ thuật</div>
            @if (User.IsInRole("Admin") || User.IsInRole("Housekeeping") || User.IsInRole("Manager") || User.IsInRole("Receptionist"))
            {
                <a asp-controller="Room" asp-action="Cleaning" class="admin-nav-link" data-controller="Room" data-action="Cleaning">
                    <div class="nav-icon"><i class="bi bi-stars"></i></div>
                    <span>Dọn phòng (HK)</span>
                </a>
            }
            <a asp-controller="Ticket" asp-action="Index" class="admin-nav-link" data-controller="Ticket" data-action="Index">
                <div class="nav-icon"><i class="bi bi-wrench-adjustable"></i></div>
                <span>Ticket sự cố & Bảo trì</span>
            </a>

            <!-- 4. BÁO CÁO & QUẢN TRỊ -->
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <div class="nav-section-title">Báo cáo & Quản trị</div>
                <a asp-controller="Report" asp-action="PmsOverview" class="admin-nav-link" data-controller="Report" data-action="PmsOverview">
                    <div class="nav-icon"><i class="bi bi-grid-3x3"></i></div>
                    <span>Thống kê PMS & Ma trận</span>
                </a>
                <a asp-controller="Report" asp-action="Revenue" class="admin-nav-link" data-controller="Report" data-action="Revenue">
                    <div class="nav-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    <span>Báo cáo doanh thu</span>
                </a>
                <a asp-controller="Room" asp-action="Types" class="admin-nav-link" data-controller="Room" data-action="Types">
                    <div class="nav-icon"><i class="bi bi-door-open"></i></div>
                    <span>Cấu hình loại phòng & giá</span>
                </a>
                <a asp-controller="Email" asp-action="Index" class="admin-nav-link" data-controller="Email" data-action="Index">
                    <div class="nav-icon"><i class="bi bi-envelope-check"></i></div>
                    <span>Nhật ký & Trạng thái Email</span>
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="User" asp-action="Index" class="admin-nav-link" data-controller="User" data-action="Index">
                    <div class="nav-icon"><i class="bi bi-people"></i></div>
                    <span>Quản lý người dùng</span>
                </a>
            }
        </div>

        <!-- Sidebar User Card -->
        <div class="sidebar-user-card">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div style="width: 34px; height: 34px; border-radius: 8px; background: rgba(212, 175, 55, 0.15); color: var(--sun-gold); display: flex; align-items: center; justify-content: center; font-weight: 700;">
                    @userFullName.Substring(0, 1).ToUpper()
                </div>
                <div style="min-width: 0; flex: 1;">
                    <div class="text-truncate fw-semibold" style="font-size: 0.85rem; color: #FFFFFF;" title="@userFullName">
                        @userFullName
                    </div>
                    <div>
                        @{
                            var badgeStyle = userRole switch
                            {
                                "Admin" => "background: rgba(168, 85, 247, 0.2); color: #C084FC; border: 1px solid rgba(168, 85, 247, 0.3);",
                                "Manager" => "background: rgba(245, 158, 11, 0.2); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3);",
                                "Receptionist" => "background: rgba(14, 165, 233, 0.2); color: #38BDF8; border: 1px solid rgba(14, 165, 233, 0.3);",
                                "Housekeeping" => "background: rgba(16, 185, 129, 0.2); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.3);",
                                "Maintenance" => "background: rgba(249, 115, 22, 0.2); color: #FB923C; border: 1px solid rgba(249, 115, 22, 0.3);",
                                "Kitchen" => "background: rgba(239, 68, 68, 0.2); color: #FCA5A5; border: 1px solid rgba(239, 68, 68, 0.3);",
                                "Bar" => "background: rgba(236, 72, 153, 0.2); color: #F472B6; border: 1px solid rgba(236, 72, 153, 0.3);",
                                "Inventory" => "background: rgba(99, 102, 241, 0.2); color: #A5B4FC; border: 1px solid rgba(99, 102, 241, 0.3);",
                                _ => "background: rgba(255, 255, 255, 0.1); color: #E2E8F0;"
                            };
                            var roleTitle = userRole switch
                            {
                                "Admin" => "Quản trị viên (Cấu hình cao nhất)",
                                "Manager" => "Quản lý khách sạn",
                                "Receptionist" => "Lễ tân ca trực",
                                "Housekeeping" => "Buồng phòng (HK)",
                                "Maintenance" => "Kỹ thuật & Bảo trì",
                                "Kitchen" => "Nhân viên bếp núc",
                                "Bar" => "Nhân viên quầy bar",
                                "Inventory" => "Quản lý vật tư & kho",
                                _ => userRole
                            };
                        }
                        <span class="role-badge-pill" style="@badgeStyle">
                            <i class="bi bi-shield-check"></i> @roleTitle
                        </span>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-1 mt-2">
                <a asp-controller="Auth" asp-action="ChangePassword" class="btn btn-sm w-50 py-1" style="background: rgba(255,255,255,0.06); color: #CBD5E1; font-size: 0.72rem; border-radius: 6px; text-decoration: none;">
                    <i class="bi bi-key me-1"></i>Đổi pass
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="w-50 m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm w-100 py-1 text-danger" style="background: rgba(239, 68, 68, 0.1); font-size: 0.72rem; border-radius: 6px; border: none;">
                        <i class="bi bi-box-arrow-right me-1"></i>Thoát
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- ═══ MAIN WRAPPER ═══ -->
    <div class="admin-main">
        <!-- TOPBAR -->
        <header class="admin-topbar">
            <!-- Left: Breadcrumb / Title -->
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggleBtn" type="button">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0" style="font-size: 0.75rem;">
                            <li class="breadcrumb-item"><span class="text-muted">Quản trị</span></li>
                            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                    <h5 class="mb-0 fw-bold" style="color: var(--sun-navy); font-size: 1.1rem;">Sun Hotel Management</h5>
                </div>
            </div>

            <!-- Center/Right: Live Clock & Quick Navigation -->
            <div class="d-flex align-items-center gap-3">
                <div class="live-clock-badge d-none d-md-flex">
                    <div class="status-pulse"></div>
                    <span id="hanoiClock">Đang kết nối thời gian...</span>
                </div>

                <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-1" style="font-size: 0.8rem; border-radius: 8px;">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Trang khách</span>
                </a>

                <div class="dropdown">
                    <button class="btn btn-sm d-flex align-items-center gap-2 p-1 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 8px;">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #0F172A; color: var(--sun-gold); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
                            @userFullName.Substring(0, 1).ToUpper()
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border" style="border-radius: 10px; font-size: 0.85rem;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark">@userFullName</div>
                            <small class="text-muted">@userRole</small>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Auth" asp-action="ChangePassword">
                                <i class="bi bi-key me-2 text-muted"></i>Đổi mật khẩu
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 text-primary" asp-controller="Home" asp-action="Index" target="_blank">
                                <i class="bi bi-globe me-2"></i>Xem website
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT BODY -->
        <main class="admin-content-body">
            @RenderBody()
        </main>
    </div>
</div>

<script>
    // Live Digital Clock (GMT+7 Hanoi)
    function updateHanoiClock() {
        const now = new Date();
        const options = {
            timeZone: 'Asia/Ho_Chi_Minh',
            hour12: false,
            weekday: 'short',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const formatter = new Intl.DateTimeFormat('vi-VN', options);
        const clockEl = document.getElementById('hanoiClock');
        if (clockEl) {
            clockEl.textContent = formatter.format(now) + ' (GMT+7)';
        }
    }
    setInterval(updateHanoiClock, 1000);
    updateHanoiClock();

    // High-precision Active Navigation Link detector
    document.addEventListener("DOMContentLoaded", function () {
        const path = window.location.pathname.toLowerCase();
        const links = document.querySelectorAll(".admin-nav-link");
        
        let exactMatch = null;
        let prefixMatch = null;

        links.forEach(link => {
            const href = (link.getAttribute("href") || "").toLowerCase();
            const controller = (link.getAttribute("data-controller") || "").toLowerCase();
            const action = (link.getAttribute("data-action") || "").toLowerCase();

            if (href && (path === href || path === href + "/")) {
                exactMatch = link;
            } else if (controller && action && path.startsWith("/" + controller + "/" + action)) {
                exactMatch = link;
            } else if (controller && path.startsWith("/" + controller)) {
                if (!prefixMatch) prefixMatch = link;
            }
        });

        const targetLink = exactMatch || prefixMatch;
        if (targetLink) {
            targetLink.classList.add("active");
        } else if (path === "/admin" || path === "/admin/") {
            const dashLink = document.querySelector(".admin-nav-link[data-controller='Admin']");
            if (dashLink) dashLink.classList.add("active");
        }

        // Mobile Sidebar Toggle
        const toggleBtn = document.getElementById("sidebarToggleBtn");
        const sidebar = document.getElementById("adminSidebar");
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener("click", function() {
                if (sidebar.style.display === "flex") {
                    sidebar.style.display = "none";
                } else {
                    sidebar.style.display = "flex";
                    sidebar.style.position = "fixed";
                }
            });
        }
    });
</script>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
