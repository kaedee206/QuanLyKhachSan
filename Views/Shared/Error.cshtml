@model ErrorViewModel
@{
    ViewData["Title"] = "Loi he thong";
}

<section style="min-height: 65vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, #F5F0E8 0%, white 100%);">
    <div class="container">
        <div class="text-center">
            <!-- Error Illustration -->
            <div style="position: relative; display: inline-block; margin-bottom: 2rem;">
                <div style="width: 120px; height: 120px; border-radius: 50%; background: linear-gradient(135deg, rgba(15,37,64,0.08), rgba(26,60,94,0.04)); display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, rgba(212,175,55,0.15), rgba(212,175,55,0.05)); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-exclamation-triangle" style="font-size: 2.5rem; color: #D4AF37;"></i>
                    </div>
                </div>
            </div>

            <h1 style="font-family: 'Playfair Display', serif; font-weight: 800; font-size: 4rem; color: #0F2540; margin-bottom: 0.25rem;">
                500
            </h1>
            <h3 style="font-family: 'Playfair Display', serif; font-weight: 700; color: #0F2540; margin-bottom: 0.75rem;">
                &#272;&#227; x&#7843;y ra l&#7895;i
            </h3>
            <p style="color: #6b7280; font-size: 1rem; max-width: 480px; margin: 0 auto 1rem;">
                R&#7845;t xin l&#7895;i v&#236; s&#7921; b&#7845;t ti&#7879;n n&#224;y. H&#7879; th&#7889;ng &#273;ang g&#7863;p s&#7921; c&#7889;, vui l&#242;ng th&#7917; l&#7841;i sau ho&#7863;c li&#234;n h&#7879; b&#7897; ph&#7853;n h&#7895; tr&#7907;.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <p style="font-size: 0.82rem; color: #9ca3af; margin-bottom: 1.5rem;">
                    <i class="bi bi-hash me-1"></i> Request ID: <code style="background: #f3f0ea; padding: 2px 8px; border-radius: 4px; color: #0F2540;">@Model.RequestId</code>
                </p>
            }

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn" style="background: linear-gradient(135deg, #D4AF37, #F0D060); color: #1A3C5E; font-weight: 600; border-radius: 12px; padding: 12px 28px; font-size: 0.95rem;">
                    <i class="bi bi-house me-1"></i> Trang ch&#7911;
                </a>
                <button onclick="history.back()" class="btn" style="background: linear-gradient(135deg, #0F2540, #1A3C5E); color: white; font-weight: 600; border-radius: 12px; padding: 12px 28px; font-size: 0.95rem;">
                    <i class="bi bi-arrow-left me-1"></i> Quay l&#7841;i
                </button>
            </div>

            <!-- Contact Info -->
            <div style="margin-top: 2.5rem; padding: 1.25rem; background: #F5F0E8; border-radius: 12px; display: inline-block; border: 1px solid rgba(212,175,55,0.15);">
                <p style="font-size: 0.82rem; color: #6b7280; margin: 0;">
                    <i class="bi bi-telephone me-1" style="color: #D4AF37;"></i> C&#7847;n h&#7895; tr&#7907;? G&#7885;i
                    <strong style="color: #0F2540;">0123 456 789</strong> ho&#7863;c email
                    <strong style="color: #0F2540;">info@sunhotel.vn</strong>
                </p>
            </div>
        </div>
    </div>
</section>
