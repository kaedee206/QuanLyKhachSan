# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git

# SQL Server
SA_PASSWORD=YourStrong@Password123

# App
JWT_SECRET=YourJwtSecretAtLeast32CharsLong!
APP_BASE_URL=http://localhost:5000

# SePay (production keys từ my.sepay.vn)
SEPAY_MERCHANT_ID=YOUR_PRODUCTION_MERCHANT_ID
SEPAY_SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY

# VietQR
VIETQR_BANK_ID=MBBank
VIETQR_ACCOUNT_NO=YOUR_ACCOUNT_NUMBER
VIETQR_ACCOUNT_NAME=YOUR_NAME

# Email
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your@gmail.com
