{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SunHotelDB;User Id=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD;TrustServerCertificate=True;Encrypt=false"
  },
  "AppSettings": {
    "JwtSecret": "YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "JwtExpiresInHours": 24,
    "JwtRefreshExpiresInDays": 7,
    "BcryptRounds": 10,
    "FrontendUrl": "http://localhost:5173",
    "CheckInTime": "14:00",
    "CheckOutTime": "12:00",
    "BookingExpiryHours": 24,
    "NoShowHour": 18,
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "SePay": {
    "MerchantId": "YOUR_SEPAY_MERCHANT_ID",
    "SecretKey": "YOUR_SEPAY_SECRET_KEY",
    "Env": "production",
    "BaseUrl": "https://pay.sepay.vn",
    "ApiUrl": "https://pgapi.sepay.vn",
    "SuccessUrl": "http://localhost:5000/Payment/SePaySuccess",
    "ErrorUrl": "http://localhost:5000/Payment/SePayError",
    "CancelUrl": "http://localhost:5000/Payment/SePayCancel",
    "IpnUrl": "http://localhost:5000/webhook/sepay",
    "PollingIntervalSeconds": 60,
    "PollingMaxMinutes": 5
  },
  "VietQR": {
    "ApiUrl": "https://img.vietqr.io",
    "BankId": "MBBank",
    "AccountNo": "YOUR_VIETQR_ACCOUNT_NUMBER",
    "AccountName": "YOUR_VIETQR_ACCOUNT_NAME"
  },
  "MoMo": {
    "PartnerCode": "",
    "AccessKey": "",
    "SecretKey": "",
    "Endpoint": "https://test-payment.momo.vn/v2/gateway/api/create",
    "ReturnUrl": "http://localhost:5000/Invoice/MoMoReturn",
    "IpnUrl": "http://localhost:5000/Invoice/MoMoIpn"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "YOUR_EMAIL_USER@gmail.com",
    "Password": "YOUR_EMAIL_APP_PASSWORD",
    "From": "YOUR_EMAIL_FROM@gmail.com",
    "FromName": "Sun Hotel",
    "UseSftp": false,
    "SftpHost": "",
    "SftpPort": 22,
    "SftpUser": "",
    "SftpPassword": "",
    "LocalSmtpPort": 1025
  },
  "RateLimit": {
    "WindowMs": 900000,
    "MaxRequests": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "fileSizeLimitBytes": 5242880
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/error-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 5,
          "fileSizeLimitBytes": 5242880,
          "restrictedToMinimumLevel": "Error"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
